---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate } from '../utils/content';

export interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  readingTime?: number;
  type: 'article' | 'thought' | 'book';
  bookAuthor?: string;
  headings?: {
    id: string;
    text: string;
    level: number;
  }[];
}

const { 
  title, 
  description, 
  publishedAt, 
  updatedAt, 
  tags = [], 
  readingTime,
  type,
  bookAuthor,
  headings = []
} = Astro.props;

const typeLabels = {
  article: 'Article',
  thought: 'Thought', 
  book: 'Book Review'
};

// TOC가 있는지 확인 (h2, h3 헤딩이 있는 article)
const hasToc = type === 'article' && headings.filter(h => h.level >= 2 && h.level <= 3).length > 0;
---

<BaseLayout
  title={`${title} - blog`}
  description={description}
  type="article"
  publishedAt={publishedAt.toISOString()}
  updatedAt={updatedAt?.toISOString()}
>
  <article class={`prose-layout ${hasToc ? 'with-toc' : ''}`}>
    <div class="container">
      <header class="article-header">
        <div class="article-meta">
          <span class="article-type">{typeLabels[type]}</span>
          <time datetime={publishedAt.toISOString()} class="article-date">
            {formatDate(publishedAt)}
          </time>
          {readingTime && (
            <span class="reading-time" aria-label={`읽는 시간 ${readingTime}분`}>
              {readingTime}분
            </span>
          )}
          <span id="busuanzi_container_page_pv" class="page-views" style="display: none;">
            조회수 <span id="busuanzi_value_page_pv"></span>
          </span>
        </div>
        
        <h1 class="article-title">{title}</h1>
        
        {bookAuthor && (
          <p class="book-author">by {bookAuthor}</p>
        )}
        
        <p class="article-description">{description}</p>
        
        {updatedAt && (
          <div class="update-notice">
            최종 수정: <time datetime={updatedAt.toISOString()}>
              {formatDate(updatedAt)}
            </time>
          </div>
        )}
        
        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      
      <div class="article-content">
        <div class="article-body">
          {hasToc && (
            <TableOfContents headings={headings} />
          )}
          <div class="prose">
            <slot />
          </div>
        </div>
      </div>
      
      <footer class="article-footer">
        <nav class="article-nav" aria-label="글 네비게이션">
          <a href={`/${type === 'article' ? 'articles' : type === 'thought' ? 'thoughts' : 'bookshelf'}`} class="nav-back">
            ← {typeLabels[type]} 목록으로 돌아가기
          </a>
        </nav>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-layout {
    min-height: calc(100vh - var(--header-height));
    padding: var(--space-2xl) 0;
  }
  
  .container {
    max-width: var(--prose-max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }
  
  /* TOC가 있는 페이지는 더 넓게 */
  .with-toc .container {
    max-width: calc(var(--prose-max-width) + 280px);
  }
  
  .article-header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border-light);
  }
  
  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  
  .article-type {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
  
  .article-date {
    font-weight: 500;
  }
  
  .reading-time::before {
    content: '•';
    margin-right: var(--space-sm);
  }
  
  .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }
  
  .book-author {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }
  
  .article-description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }
  
  .update-notice {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }
  
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  .tag {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
  }
  
  .article-content {
    margin-bottom: var(--space-3xl);
  }
  
  /* 데스크탑에서 TOC가 있을 때 그리드 레이아웃 */
  @media (min-width: 1025px) {
    .with-toc .article-body {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 40px;
      align-items: start;
    }
    
    .with-toc .prose {
      max-width: 760px;
      min-width: 0;
    }
    
    /* 헤더를 prose 열과 정렬 */
    .with-toc .article-header {
      margin-left: 260px; /* 220px TOC + 40px gap */
      max-width: 760px;
    }
  }
  
  /* Prose Typography */
  .prose {
    color: var(--color-text-primary);
    line-height: 1.7;
  }
  
  .prose > * {
    margin-bottom: var(--space-lg);
  }
  
  .prose > *:last-child {
    margin-bottom: 0;
  }
  
  .prose h2 {
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
    color: var(--color-text-primary);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }
  
  .prose h3 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }
  
  .prose h4 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }
  
  .prose h5,
  .prose h6 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }
  
  .prose p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }
  
  .prose a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }
  
  .prose a:hover,
  .prose a:focus {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }
  
  .prose strong {
    font-weight: 600;
    color: var(--color-text-primary);
  }
  
  .prose em {
    font-style: italic;
  }
  
  .prose code {
    font-family: var(--font-family-mono);
    font-size: 0.875em;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
  }
  
  .prose pre {
    font-family: var(--font-family-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    background: #f8f9fa;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    overflow-x: auto;
    margin: var(--space-xl) 0;
  }
  
  .prose pre code {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }
  
  .prose blockquote {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin: var(--space-xl) 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }
  
  .prose ul,
  .prose ol {
    padding-left: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  
  .prose li {
    margin-bottom: var(--space-sm);
    line-height: 1.6;
  }
  
  .prose li > ul,
  .prose li > ol {
    margin-top: var(--space-sm);
    margin-bottom: 0;
  }
  
  .prose hr {
    border: none;
    border-top: 1px solid var(--color-border-light);
    margin: var(--space-2xl) 0;
  }
  
  .prose img {
    border-radius: var(--radius-md);
    margin: var(--space-xl) 0;
  }
  
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-xl) 0;
    font-size: 0.875rem;
  }
  
  .prose table th,
  .prose table td {
    padding: var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--color-border-light);
  }
  
  .prose table th {
    background: var(--color-surface);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  
  .article-footer {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border-light);
  }
  
  .nav-back {
    display: inline-flex;
    align-items: center;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    min-height: 44px;
  }
  
  .nav-back:hover,
  .nav-back:focus {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: rgba(99, 102, 241, 0.05);
  }
  
  /* Mobile responsive */
  @media (max-width: 768px) {
    .prose-layout {
      padding: var(--space-xl) 0;
    }
    
    .article-title {
      font-size: 2rem;
    }
    
    .article-description {
      font-size: 1.125rem;
    }
    
    .article-meta {
      flex-wrap: wrap;
      gap: var(--space-sm);
    }
    
    .prose h2 {
      font-size: 1.5rem;
      scroll-margin-top: var(--space-md);
    }
    
    .prose h3 {
      font-size: 1.25rem;
      scroll-margin-top: var(--space-md);
    }
  }
  
  @media (max-width: 480px) {
    .container {
      padding: 0 var(--space-sm);
    }
    
    .article-title {
      font-size: 1.75rem;
    }
    
    .prose pre {
      padding: var(--space-md);
      font-size: 0.8rem;
    }
  }
</style>
