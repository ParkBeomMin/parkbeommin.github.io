---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles, getPublishedThoughts, getPublishedBooks, formatDate } from '../../utils/content';

// 모든 게시된 콘텐츠 가져오기
const [articles, thoughts, books] = await Promise.all([
  getPublishedArticles(),
  getPublishedThoughts(),
  getPublishedBooks()
]);

// 타임라인 항목 타입
type TimelineItem = {
  id: string;
  title: string;
  description?: string;
  publishedAt: Date;
  type: 'article' | 'thought' | 'book';
  tags: string[];
  readingTime?: number;
  bookAuthor?: string;
};

// 모든 항목을 타임라인 형식으로 변환
const timelineItems: TimelineItem[] = [
  ...articles.map(article => ({
    id: article.id,
    title: article.data.title,
    description: article.data.description,
    publishedAt: article.data.publishedAt,
    type: 'article' as const,
    tags: article.data.tags,
    readingTime: article.data.readingTime
  })),
  ...thoughts.map(thought => ({
    id: thought.id,
    title: thought.data.title,
    description: thought.data.description,
    publishedAt: thought.data.publishedAt,
    type: 'thought' as const,
    tags: thought.data.tags
  })),
  ...books.map(book => ({
    id: book.id,
    title: book.data.title,
    description: book.data.description,
    publishedAt: book.data.publishedAt,
    type: 'book' as const,
    tags: book.data.tags,
    readingTime: book.data.readingTime,
    bookAuthor: book.data.bookAuthor
  }))
];

// 날짜순 정렬 (최신순)
timelineItems.sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime());

const typeLabels = {
  article: '글',
  thought: '생각',
  book: '책'
};

const typeRoutes = {
  article: 'articles',
  thought: 'thoughts',
  book: 'bookshelf'
};
---

<BaseLayout
  title="Timeline - blog"
  description="모든 글, 생각, 책을 시간순으로 정리한 타임라인입니다."
>
  <div class="timeline-page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">Timeline</h1>
        <p class="page-description">
          지금까지 작성한 모든 글, 생각, 책 리뷰를 시간순으로 정리했습니다.
        </p>
      </header>

      {timelineItems.length === 0 ? (
        <div class="empty-state">
          <p>아직 작성된 콘텐츠가 없습니다.</p>
        </div>
      ) : (
        <div class="timeline">
          {timelineItems.map((item, index) => (
            <article class="timeline-item">
              <div class="timeline-marker">
                <div class="timeline-dot"></div>
                {index < timelineItems.length - 1 && (
                  <div class="timeline-line"></div>
                )}
              </div>

              <div class="timeline-content">
                <header class="item-header">
                  <div class="item-meta">
                    <time
                      datetime={item.publishedAt.toISOString()}
                      class="item-date"
                    >
                      {formatDate(item.publishedAt)}
                    </time>
                    <span class="item-type">{typeLabels[item.type]}</span>
                    {item.readingTime && (
                      <span class="item-reading-time">
                        {item.readingTime}분
                      </span>
                    )}
                  </div>

                  <h2 class="item-title">
                    <a href={`/${typeRoutes[item.type]}/${item.id}`}>
                      {item.title}
                    </a>
                  </h2>

                  {item.bookAuthor && (
                    <p class="item-author">by {item.bookAuthor}</p>
                  )}
                </header>

                {item.description && (
                  <p class="item-description">{item.description}</p>
                )}

                {item.tags.length > 0 && (
                  <div class="item-tags">
                    {item.tags.map(tag => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .timeline-page {
    min-height: calc(100vh - var(--header-height));
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
    text-align: center;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-lg);
    color: var(--color-text-primary);
  }

  .page-description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .timeline {
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline-item {
    display: flex;
    position: relative;
    margin-bottom: var(--space-2xl);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    flex-shrink: 0;
    width: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border-radius: 50%;
    border: 3px solid var(--color-surface);
    box-shadow: 0 0 0 3px var(--color-accent);
    z-index: 2;
  }

  .timeline-line {
    width: 2px;
    background: var(--color-border-light);
    flex: 1;
    margin-top: 8px;
  }

  .timeline-content {
    flex: 1;
    padding-left: var(--space-lg);
  }

  .item-header {
    margin-bottom: var(--space-md);
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
    font-size: 0.875rem;
  }

  .item-date {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .item-type {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .item-reading-time {
    color: var(--color-text-muted);
  }

  .item-reading-time::before {
    content: '•';
    margin-right: var(--space-sm);
  }

  .item-title {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }

  .item-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .item-title a:hover,
  .item-title a:focus {
    color: var(--color-accent);
  }

  .item-author {
    font-size: 1rem;
    color: var(--color-text-secondary);
    font-style: italic;
    margin-bottom: var(--space-sm);
  }

  .item-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .timeline-marker {
      width: 40px;
    }

    .timeline-content {
      padding-left: var(--space-md);
    }

    .item-meta {
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .item-title {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 var(--space-sm);
    }

    .page-title {
      font-size: 1.75rem;
    }

    .timeline-marker {
      width: 32px;
    }

    .timeline-content {
      padding-left: var(--space-sm);
    }

    .timeline-dot {
      width: 8px;
      height: 8px;
    }
  }
</style>
