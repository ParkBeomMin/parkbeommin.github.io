---
// Search overlay component for global search functionality
---

<div id="search-overlay" class="search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-title">
  <div class="search-backdrop" data-search-close></div>
  <div class="search-modal">
    <header class="search-header">
      <h2 id="search-title" class="search-title">검색</h2>
      <button
        type="button"
        class="search-close-btn"
        aria-label="검색 닫기"
        data-search-close
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </header>
    <div class="search-input-container">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M19 19L14.65 14.65M17 9A8 8 0 1 1 1 9A8 8 0 0 1 17 9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="글 제목, 내용, 태그로 검색..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="search-results-container">
      <div id="search-empty-state" class="search-empty-state">
        <p>검색어를 입력하면 글, 생각, 책 리뷰를 찾을 수 있습니다.</p>
        <p class="search-shortcut-hint">
          <kbd>Cmd</kbd> + <kbd>K</kbd> 또는 <kbd>/</kbd>로 언제든지 검색할 수 있습니다.
        </p>
      </div>

      <div id="search-no-results" class="search-no-results" hidden>
        <p>검색 결과가 없습니다.</p>
        <p>다른 키워드로 다시 시도해보세요.</p>
      </div>

      <div id="search-loading" class="search-loading" hidden>
        <p>검색 중...</p></div>

      <ul id="search-results" class="search-results" aria-label="검색 결과"></ul>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .search-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .search-overlay.open .search-modal {
    transform: translateY(0);
  }

  .search-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    cursor: pointer;
  }

  .search-modal {
    position: relative;
    max-width: 600px;
    width: calc(100% - var(--space-lg) * 2);
    margin: 10vh auto 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    transform: translateY(-20px);
    transition: transform 0.2s ease;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
  }

  .search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border-light);
  }

  .search-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }

  .search-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .search-close-btn:hover,
  .search-close-btn:focus {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
  }

  .search-input-container {
    position: relative;
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border-light);
  }

  .search-icon {
    position: absolute;
    left: calc(var(--space-lg) + var(--space-md));
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: var(--space-md) var(--space-md) var(--space-md) 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-results-container {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .search-empty-state,
  .search-no-results,
  .search-loading {
    padding: var(--space-2xl);
    text-align: center;
    color: var(--color-text-muted);
  }

  .search-empty-state p:first-child,
  .search-no-results p:first-child {
    font-size: 1.125rem;
    margin-bottom: var(--space-md);
  }

  .search-shortcut-hint {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .search-shortcut-hint kbd {
    display: inline-block;
    padding: 2px 6px;
    background: var(--color-border-light);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .search-results {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-y: auto;
    flex: 1;
  }

  /* Global styles for dynamically created elements */
  :global(.search-result-item) {
    border-bottom: 1px solid var(--color-border-light);
  }

  :global(.search-result-item:last-child) {
    border-bottom: none;
  }

  :global(.search-result-link) {
    display: block;
    padding: var(--space-lg);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  :global(.search-result-link:hover),
  :global(.search-result-link:focus) {
    background: rgba(99, 102, 241, 0.05);
  }

  :global(.search-result-header) {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  :global(.search-result-type) {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  :global(.search-result-date) {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  :global(.search-result-title) {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }

  :global(.search-result-description) {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  :global(.search-result-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  :global(.search-result-tag) {
    padding: 2px 6px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .search-modal {
      margin: 5vh auto 0;
      width: calc(100% - var(--space-md) * 2);
      max-height: 85vh;
    }

    .search-header,
    .search-input-container {
      padding: var(--space-md);
    }

    .search-result-link {
      padding: var(--space-md);
    }

    .search-result-header {
      flex-wrap: wrap;
      gap: var(--space-sm);
    }
  }

  @media (max-width: 480px) {
    .search-modal {
      margin: 2vh auto 0;
      width: calc(100% - var(--space-sm) * 2);
      max-height: 90vh;
    }
  }

  /* Prevent body scroll when overlay is open - Global style */
  :global(.search-overlay-open) {
    overflow: hidden !important;
  }

  /* Focus states */
  .search-result-link:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .search-overlay,
    .search-modal,
    .search-close-btn,
    .search-input,
    .search-result-link {
      transition: none;
    }
  }
</style>

<script>
  interface SearchItem {
    id: string;
    title: string;
    description: string;
    content: string;
    type: 'article' | 'thought' | 'book';
    typeLabel: string;
    publishedAt: string;
    tags: string[];
    url: string;
    bookAuthor?: string;
  }

  class SearchOverlay {
    private overlay!: HTMLElement;
    private input!: HTMLInputElement;
    private results!: HTMLElement;
    private emptyState!: HTMLElement;
    private noResults!: HTMLElement;
    private loading!: HTMLElement;
    private searchIndex: SearchItem[] = [];
    private isOpen = false;
    private debounceTimer: number | null = null;
    private lastFocusedElement: HTMLElement | null = null;
    public static instance: SearchOverlay | null = null;

    constructor() {
      // 단일 인스턴스 패턴으로 중복 초기화 방지
      if (SearchOverlay.instance) {
        return SearchOverlay.instance;
      }

      this.initialize();
      this.bindEvents();
      SearchOverlay.instance = this;
    }

    private initialize() {
      this.overlay = document.getElementById('search-overlay')!;
      this.input = document.getElementById('search-input') as HTMLInputElement;
      this.results = document.getElementById('search-results')!;
      this.emptyState = document.getElementById('search-empty-state')!;
      this.noResults = document.getElementById('search-no-results')!;
      this.loading = document.getElementById('search-loading')!;
    }

    private bindEvents() {
      // 중복 리스너 방지
      this.removeExistingListeners();

      // Open button
      const searchButton = document.querySelector('[data-search-open]');
      if (searchButton) {
        searchButton.addEventListener('click', this.openHandler);
      }

      // Close buttons
      document.querySelectorAll('[data-search-close]').forEach(btn => {
        btn.addEventListener('click', this.closeHandler);
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', this.keydownHandler);

      // Search input
      this.input.addEventListener('input', this.inputHandler);

      // Focus trap
      this.overlay.addEventListener('keydown', this.focusTrapHandler);

      // Backdrop clicks
      this.overlay.addEventListener('click', this.backdropHandler);

      // Prevent modal clicks from closing
      this.overlay.querySelector('.search-modal')?.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    }

    private removeExistingListeners() {
      document.removeEventListener('keydown', this.keydownHandler);
      this.input?.removeEventListener('input', this.inputHandler);
      this.overlay?.removeEventListener('keydown', this.focusTrapHandler);
      this.overlay?.removeEventListener('click', this.backdropHandler);
    }

    private openHandler = () => this.open();
    private closeHandler = () => this.close();
    private inputHandler = () => this.debounceSearch();
    private keydownHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && this.isOpen) {
        this.close();
      } else if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        this.open();
      } else if (e.key === '/' && !this.isFormField(e.target as Element)) {
        e.preventDefault();
        this.open();
      }
    };

    private focusTrapHandler = (e: KeyboardEvent) => {
      if (!this.isOpen || e.key !== 'Tab') return;

      const focusableElements = this.overlay.querySelectorAll(
        'button, [href], input, [tabindex]:not([tabindex="-1"])'
      );
      const firstElement = focusableElements[0] as HTMLElement;
      const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;

      if (e.shiftKey && document.activeElement === firstElement) {
        e.preventDefault();
        lastElement.focus();
      } else if (!e.shiftKey && document.activeElement === lastElement) {
        e.preventDefault();
        firstElement.focus();
      }
    };

    private backdropHandler = (e: Event) => {
      if (e.target === this.overlay) {
        this.close();
      }
    };

    private isFormField(element: Element): boolean {
      const formTags = ['input', 'textarea', 'select'];
      return formTags.includes(element.tagName.toLowerCase()) ||
             element.hasAttribute('contenteditable');
    }

    async open() {
      if (this.isOpen) return;

      // 현재 포커스된 엘리먼트 저장
      this.lastFocusedElement = document.activeElement as HTMLElement;

      this.isOpen = true;
      this.overlay.classList.add('open');
      this.overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('search-overlay-open');

      // Load search index if not already loaded
      if (this.searchIndex.length === 0) {
        await this.loadSearchIndex();
      }

      // Focus input
      setTimeout(() => {
        this.input.focus();
      }, 100);

      this.showEmptyState();
    }

    close() {
      if (!this.isOpen) return;

      this.isOpen = false;
      this.overlay.classList.remove('open');
      this.overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('search-overlay-open');

      // Clear search
      this.input.value = '';
      this.showEmptyState();

      // 원래 포커스된 엘리먼트로 복원
      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
        this.lastFocusedElement = null;
      }
    }

    private async loadSearchIndex() {
      try {
        this.showLoading();
        const response = await fetch('/search-index.json');
        if (!response.ok) throw new Error(`HTTP ${response.status}: ${response.statusText}`);

        this.searchIndex = await response.json();
        this.showEmptyState(); // 로딩 완료 시 빈 상태로 복원
      } catch (error) {
        console.error('Failed to load search index:', error);
        this.showLoadError();
      }
    }

    private showLoadError() {
      this.hideAll();
      this.noResults.innerHTML = `
        <p>검색 인덱스를 불러오지 못했습니다.</p>
        <p>페이지를 새로고침하고 다시 시도해보세요.</p>
      `;
      this.noResults.hidden = false;
    }

    private debounceSearch() {
      if (this.debounceTimer) {
        clearTimeout(this.debounceTimer);
      }

      this.debounceTimer = window.setTimeout(() => {
        this.performSearch();
      }, 300);
    }

    private performSearch() {
      const query = this.input.value.trim().toLowerCase();

      if (!query) {
        this.showEmptyState();
        return;
      }

      const results = this.searchIndex.filter(item => {
        const searchText = `${item.title} ${item.description} ${item.content} ${item.tags.join(' ')}`.toLowerCase();
        return searchText.includes(query);
      });

      if (results.length === 0) {
        this.showNoResults();
      } else {
        this.showResults(results.slice(0, 20)); // Limit to 20 results
      }
    }

    private showEmptyState() {
      this.hideAll();
      this.emptyState.hidden = false;
    }

    private showNoResults() {
      this.hideAll();
      this.noResults.hidden = false;
    }

    private showLoading() {
      this.hideAll();
      this.loading.hidden = false;
    }

    private showResults(items: SearchItem[]) {
      this.hideAll();
      this.results.innerHTML = '';

      items.forEach(item => {
        const li = document.createElement('li');
        li.className = 'search-result-item';

        const date = new Date(item.publishedAt).toLocaleDateString('ko-KR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });

        li.innerHTML = `
          <a href="${this.escapeHtml(item.url)}" class="search-result-link">
            <div class="search-result-header">
              <span class="search-result-type">${this.escapeHtml(item.typeLabel)}</span>
              <time class="search-result-date" datetime="${item.publishedAt}">${this.escapeHtml(date)}</time>
            </div>
            <h3 class="search-result-title">${this.escapeHtml(item.title)}</h3>
            ${item.description ? `<p class="search-result-description">${this.escapeHtml(item.description)}</p>` : ''}
            ${item.bookAuthor ? `<p class="search-result-description">by ${this.escapeHtml(item.bookAuthor)}</p>` : ''}
            ${item.tags.length > 0 ? `
              <div class="search-result-tags">
                ${item.tags.map(tag => `<span class="search-result-tag">${this.escapeHtml(tag)}</span>`).join('')}
              </div>
            ` : ''}
          </a>
        `;

        // Close overlay when clicking a result
        li.querySelector('a')?.addEventListener('click', () => {
          this.close();
        });

        this.results.appendChild(li);
      });

      this.results.hidden = false;
    }

    private hideAll() {
      this.emptyState.hidden = true;
      this.noResults.hidden = true;
      this.loading.hidden = true;
      this.results.hidden = true;
    }

    private escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  }

  // 단일 초기화 보장
  function initializeSearchOverlay() {
    if (!SearchOverlay.instance) {
      new SearchOverlay();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSearchOverlay);
  } else {
    initializeSearchOverlay();
  }
</script>
