---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  orientation?: 'horizontal' | 'vertical';
}

const { size = 'md', orientation = 'horizontal' } = Astro.props;

const sizeClasses = {
  sm: 'social-links--sm',
  md: 'social-links--md',
  lg: 'social-links--lg'
};

const orientationClass = orientation === 'vertical' ? 'social-links--vertical' : 'social-links--horizontal';
---

<div class={`social-links ${sizeClasses[size]} ${orientationClass}`}>
  <a
    href="https://github.com/ParkBeomMin"
    class="social-link social-link--github"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub"
  >
    <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 0C5.37 0 0 5.37 0 12C0 17.31 3.435 21.795 8.205 23.385C8.805 23.49 9.03 23.13 9.03 22.815C9.03 22.53 9.015 21.585 9.015 20.58C6 21.135 5.22 19.845 4.98 19.17C4.845 18.825 4.26 17.76 3.75 17.475C3.33 17.25 2.73 16.695 3.735 16.68C4.68 16.665 5.355 17.55 5.58 17.91C6.66 19.725 8.385 19.215 9.075 18.9C9.18 18.12 9.495 17.595 9.84 17.295C7.17 16.995 4.38 15.96 4.38 11.37C4.38 10.065 4.845 8.985 5.61 8.145C5.49 7.845 5.07 6.615 5.73 4.965C5.73 4.965 6.735 4.65 9.03 6.195C9.99 5.925 11.01 5.79 12.03 5.79C13.05 5.79 14.07 5.925 15.03 6.195C17.325 4.635 18.33 4.965 18.33 4.965C18.99 6.615 18.57 7.845 18.45 8.145C19.215 8.985 19.68 10.05 19.68 11.37C19.68 15.975 16.875 16.995 14.205 17.295C14.64 17.67 15.015 18.39 15.015 19.515C15.015 21.12 15 22.41 15 22.815C15 23.13 15.225 23.505 15.825 23.385C18.2072 22.5807 20.2772 21.0497 21.7437 19.0074C23.2101 16.965 23.9993 14.5143 24 12C24 5.37 18.63 0 12 0Z" fill="currentColor"/>
    </svg>
    <span class="social-text">GitHub</span>
  </a>

  <a
    href="/rss.xml"
    class="social-link social-link--rss"
    aria-label="RSS 피드"
  >
    <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 11C4 15.4183 7.58172 19 12 19C16.4183 19 20 15.4183 20 11C20 6.58172 16.4183 3 12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M4 4V7C4 13.6274 9.37258 19 16 19H19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <circle cx="5" cy="17" r="1" fill="currentColor"/>
    </svg>
    <span class="social-text">RSS 피드</span>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    gap: var(--space-md);
  }

  .social-links--horizontal {
    flex-direction: row;
    align-items: center;
  }

  .social-links--vertical {
    flex-direction: column;
    align-items: flex-start;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
  }

  .social-link:hover,
  .social-link:focus {
    color: var(--color-accent);
    background: rgba(99, 102, 241, 0.1);
  }

  .social-link:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .social-icon {
    flex-shrink: 0;
  }

  .social-text {
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Size variants */
  .social-links--sm .social-link {
    padding: var(--space-xs);
    min-height: 44px;
    min-width: 44px;
  }

  .social-links--sm .social-icon {
    width: 16px;
    height: 16px;
  }

  .social-links--sm .social-text {
    font-size: 0.75rem;
  }

  .social-links--md .social-icon {
    width: 20px;
    height: 20px;
  }

  .social-links--lg .social-link {
    padding: var(--space-md);
    min-height: 48px;
    min-width: 48px;
  }

  .social-links--lg .social-icon {
    width: 24px;
    height: 24px;
  }

  .social-links--lg .social-text {
    font-size: 1rem;
  }

  /* Icon-only variant for compact spaces */
  .social-links--icon-only .social-text {
    display: none;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .social-links {
      gap: var(--space-sm);
    }

    /* Convert to icon-only on mobile for horizontal layouts */
    .social-links--horizontal .social-text {
      display: none;
    }
  }

  /* Specific link styling */
  .social-link--github:hover,
  .social-link--github:focus {
    color: #24292e;
    background: rgba(36, 41, 46, 0.1);
  }

  .social-link--rss:hover,
  .social-link--rss:focus {
    color: #ff6600;
    background: rgba(255, 102, 0, 0.1);
  }

  /* Dark theme support (if needed later) */
  @media (prefers-color-scheme: dark) {
    .social-link--github:hover,
    .social-link--github:focus {
      color: #f0f6fc;
      background: rgba(240, 246, 252, 0.1);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .social-link {
      transition: none;
    }
  }
</style>
