---
import type { ThoughtEntry } from '../utils/content';
import { formatDate } from '../utils/content';

export interface Props {
  thoughts: ThoughtEntry[];
  showMore?: boolean;
}

const { thoughts, showMore = true } = Astro.props;
const displayedThoughts = thoughts.slice(0, 4);
---

<section class="thoughts-section" aria-labelledby="thoughts-title">
  <div class="section-header">
    <h2 id="thoughts-title" class="section-title">Thoughts</h2>
    {showMore && thoughts.length > 4 && (
      <a href="/thoughts" class="section-more">더 보기</a>
    )}
  </div>

  <div class="thoughts-list">
    {displayedThoughts.map(thought => (
      <article class="thought-item">
        <time datetime={thought.data.publishedAt.toISOString()} class="thought-date">
          {formatDate(thought.data.publishedAt, 'ko-KR').replace(/년|월/g, '.').replace(/일/, '')}
        </time>
        <h3 class="thought-title">
          <a href={`/thoughts/${thought.id}`} class="thought-link">
            {thought.data.title}
          </a>
        </h3>
      </article>
    ))}
  </div>

  {showMore && (
    <div class="thoughts-footer">
      <a href="/thoughts" class="thoughts-view-all">
        모든 생각 보기
      </a>
    </div>
  )}
</section>

<style>
  .thoughts-section {
    padding: 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-xl);
  }

  .section-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-xs);
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .section-more:hover,
  .section-more:focus {
    color: var(--color-accent-hover);
  }

  .thoughts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .thought-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .thought-item:last-child {
    border-bottom: none;
  }

  .thought-date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    min-width: 60px;
  }

  .thought-title {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    flex: 1;
  }

  .thought-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .thought-link:hover,
  .thought-link:focus {
    color: var(--color-accent);
  }

  .thoughts-footer {
    margin-top: var(--space-lg);
    text-align: left;
  }

  .thoughts-view-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-xs);
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .thoughts-view-all:hover,
  .thoughts-view-all:focus {
    color: var(--color-accent-hover);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .thought-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
      padding: var(--space-md) 0;
    }

    .thought-date {
      min-width: auto;
      font-size: 0.75rem;
    }

    .section-header {
      align-items: center;
    }

    .section-title {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }
  }
</style>
