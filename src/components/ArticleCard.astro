---
import type { ArticleEntry } from '../utils/content';
import { formatDate } from '../utils/content';

export interface Props {
  article: ArticleEntry;
  variant?: 'secondary' | 'list';
}

const { article, variant = 'secondary' } = Astro.props;
const { id, data } = article;
---

<article class={`article-card article-card--${variant}`}>
  {variant === 'secondary' && (
    <div class="card-thumbnail">
      <svg width="120" height="80" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="120" height="80" rx="6" fill="var(--color-accent)" opacity="0.1"/>
        <rect x="12" y="20" width="96" height="4" rx="2" fill="var(--color-accent)" opacity="0.3"/>
        <rect x="12" y="32" width="72" height="3" rx="1.5" fill="var(--color-accent)" opacity="0.2"/>
        <rect x="12" y="42" width="84" height="3" rx="1.5" fill="var(--color-accent)" opacity="0.2"/>
        <circle cx="96" cy="60" r="8" fill="var(--color-accent)" opacity="0.4"/>
      </svg>
    </div>
  )}
  
  <div class="card-content">
    <div class="card-meta">
      <time datetime={data.publishedAt.toISOString()} class="card-date">
        {formatDate(data.publishedAt)}
      </time>
      {data.readingTime && (
        <span class="card-reading-time" aria-label={`읽는 시간 ${data.readingTime}분`}>
          {data.readingTime}분
        </span>
      )}
    </div>
    
    <h3 class="card-title">
      <a href={`/blog/articles/${id}`} class="card-link">
        {data.title}
      </a>
    </h3>
    
    {variant === 'secondary' && (
      <p class="card-excerpt">
        {data.description}
      </p>
    )}
    
    {data.tags.length > 0 && variant === 'list' && (
      <div class="card-tags">
        {data.tags.slice(0, 2).map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .article-card {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  
  .article-card:hover {
    border-color: var(--color-border);
    transform: translateY(-2px);
  }
  
  .article-card--secondary {
    flex-direction: column;
  }
  
  .article-card--list {
    flex-direction: row;
    align-items: flex-start;
    padding: var(--space-md);
  }
  
  .card-thumbnail {
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  
  .card-content {
    flex: 1;
  }
  
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  
  .article-card--list .card-meta {
    font-size: 0.875rem;
  }
  
  .card-date {
    font-weight: 500;
  }
  
  .card-reading-time::before {
    content: '•';
    margin-right: var(--space-sm);
  }
  
  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }
  
  .article-card--list .card-title {
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }
  
  .card-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .card-link:hover,
  .card-link:focus {
    color: var(--color-accent);
  }
  
  .card-excerpt {
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    font-size: 0.875rem;
  }
  
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }
  
  .tag {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }
  
  /* Mobile responsive */
  @media (max-width: 768px) {
    .article-card--list {
      flex-direction: column;
    }
    
    .card-title {
      font-size: 1rem;
    }
    
    .card-excerpt {
      font-size: 0.875rem;
    }
  }
</style>