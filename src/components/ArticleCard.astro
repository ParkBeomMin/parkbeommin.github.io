---
import type { ArticleEntry } from '../utils/content';
import { formatDate } from '../utils/content';
import { getArticleThumbnail } from '../utils/thumbnail';

export interface Props {
  article: ArticleEntry;
  variant?: 'secondary' | 'list';
}

const { article, variant = 'secondary' } = Astro.props;
const { id, data } = article;
const thumbnail = getArticleThumbnail(data.cover, data.coverAlt, article.body, data.title);
---

<article class={`article-card article-card--${variant}`}>
  {variant === 'secondary' && (
    <div class="card-thumbnail">
      {thumbnail.isPlaceholder ? (
        <div class="placeholder-svg" aria-hidden="true">
          <svg width="120" height="80" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="120" height="80" rx="4" fill="#6366f1" opacity="0.1"/>
            <rect x="10" y="20" width="100" height="4" rx="2" fill="#6366f1" opacity="0.3"/>
            <rect x="10" y="30" width="80" height="3" rx="1.5" fill="#6366f1" opacity="0.2"/>
            <rect x="10" y="40" width="90" height="3" rx="1.5" fill="#6366f1" opacity="0.2"/>
            <circle cx="100" cy="60" r="8" fill="#6366f1" opacity="0.4"/>
          </svg>
        </div>
      ) : (
        <img
          src={thumbnail.src}
          alt={thumbnail.alt}
          width="120"
          height="80"
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  )}

  <div class="card-content">
    <div class="card-meta">
      <time datetime={data.publishedAt.toISOString()} class="card-date">
        {formatDate(data.publishedAt)}
      </time>
      {data.readingTime && (
        <span class="card-reading-time" aria-label={`읽는 시간 ${data.readingTime}분`}>
          {data.readingTime}분
        </span>
      )}
    </div>

    <h3 class="card-title">
      <a href={`/articles/${id}`} class="card-link">
        {data.title}
      </a>
    </h3>

    {variant === 'secondary' && (
      <p class="card-excerpt">
        {data.description}
      </p>
    )}

    {data.tags.length > 0 && variant === 'list' && (
      <div class="card-tags">
        {data.tags.slice(0, 2).map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .article-card {
    display: flex;
    gap: var(--space-lg);
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    transition: transform 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-1px);
  }

  .article-card--secondary {
    flex-direction: column;
    padding: var(--space-xl);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .article-card--list {
    flex-direction: row;
    align-items: flex-start;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .article-card--list:last-child {
    border-bottom: none;
  }

  .card-thumbnail {
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-thumbnail img,
  .card-thumbnail .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-svg svg {
    width: 100%;
    height: 100%;
  }

  .card-content {
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .article-card--list .card-meta {
    font-size: 0.875rem;
    margin-bottom: var(--space-sm);
  }

  .card-date {
    font-weight: 600;
  }

  .card-reading-time::before {
    content: '•';
    margin-right: var(--space-sm);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-md);
    letter-spacing: -0.01em;
  }

  .article-card--list .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .card-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-link:hover,
  .card-link:focus {
    color: var(--color-accent);
  }

  .card-excerpt {
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    font-size: 0.95rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .tag {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: rgba(99, 102, 241, 0.08);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .article-card--list {
      flex-direction: column;
      padding: var(--space-md) 0;
    }

    .article-card--secondary {
      padding: var(--space-lg);
    }

    .card-title {
      font-size: 1.125rem;
    }

    .article-card--list .card-title {
      font-size: 1rem;
    }

    .card-excerpt {
      font-size: 0.9rem;
    }
  }
</style>
