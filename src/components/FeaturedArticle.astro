---
import type { ArticleEntry } from '../utils/content';
import { formatDate, extractExcerpt } from '../utils/content';
import { getArticleThumbnail } from '../utils/thumbnail';

export interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const { id, data } = article;
const excerpt = extractExcerpt(article.body || '', 200);
const thumbnail = getArticleThumbnail(data.cover, data.coverAlt, article.body, data.title);
---

<article class="featured-article" aria-labelledby="featured-title">
  <div class="featured-content">
    <div class="featured-thumbnail">
      {thumbnail.isPlaceholder ? (
        <div class="placeholder-svg" aria-hidden="true">
          <svg width="240" height="140" viewBox="0 0 240 140" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="240" height="140" rx="8" fill="#6366f1" opacity="0.1"/>
            <rect x="20" y="30" width="200" height="8" rx="4" fill="#6366f1" opacity="0.3"/>
            <rect x="20" y="50" width="160" height="6" rx="3" fill="#6366f1" opacity="0.2"/>
            <rect x="20" y="70" width="180" height="6" rx="3" fill="#6366f1" opacity="0.2"/>
            <circle cx="200" cy="100" r="16" fill="#6366f1" opacity="0.4"/>
          </svg>
        </div>
      ) : (
        <img
          src={thumbnail.src}
          alt={thumbnail.alt}
          width="240"
          height="140"
          loading="lazy"
          decoding="async"
        />
      )}
    </div>

    <div class="featured-info">
      <div class="featured-meta">
        <time datetime={data.publishedAt.toISOString()} class="featured-date">
          {formatDate(data.publishedAt)}
        </time>
        {data.readingTime && (
          <span class="featured-reading-time" aria-label={`읽는 시간 ${data.readingTime}분`}>
            {data.readingTime}분
          </span>
        )}
      </div>

      <h2 id="featured-title" class="featured-title">
        <a href={`/articles/${id}`} class="featured-link">
          {data.title}
        </a>
      </h2>

      <p class="featured-excerpt">
        {excerpt || data.description}
      </p>

      {data.tags.length > 0 && (
        <div class="featured-tags">
          {data.tags.slice(0, 3).map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .featured-article {
    padding: 0 0 var(--space-3xl) 0;
    margin-bottom: var(--space-2xl);
  }

  .featured-content {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-3xl);
    align-items: flex-start;
  }

  .featured-thumbnail {
    border-radius: var(--radius-lg);
    overflow: hidden;
    order: 2;
  }

  .featured-thumbnail img,
  .featured-thumbnail .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-svg svg {
    width: 100%;
    height: 100%;
  }

  .featured-info {
    order: 1;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .featured-date {
    font-weight: 600;
  }

  .featured-reading-time::before {
    content: '•';
    margin-right: var(--space-sm);
  }

  .featured-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: var(--space-xl);
    letter-spacing: -0.03em;
  }

  .featured-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-link:hover,
  .featured-link:focus {
    color: var(--color-accent);
  }

  .featured-excerpt {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    max-width: 32em;
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background: rgba(99, 102, 241, 0.08);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .featured-content {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .featured-thumbnail {
      order: 0;
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }

    .featured-info {
      order: 1;
    }

    .featured-title {
      font-size: 2.125rem;
    }

    .featured-excerpt {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 480px) {
    .featured-article {
      padding: 0 0 var(--space-2xl) 0;
      margin-bottom: var(--space-xl);
    }

    .featured-title {
      font-size: 1.75rem;
    }

    .featured-excerpt {
      font-size: 1rem;
    }

    .featured-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .featured-reading-time::before {
      display: none;
    }
  }
</style>
